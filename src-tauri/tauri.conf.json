{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenStreamDeck",
  "version": "0.1.0",
  "identifier": "dev.openstreamdeck.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenStreamDeck",
        "width": 1380,
        "height": 900,
        "minWidth": 1060,
        "minHeight": 720,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "N3 controller and AI workflow deck",
    "category": "Productivity",
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-openstreamdeck.rules": "bundle/70-openstreamdeck.rules"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/DEKHTIARJonathan/OpenStreamDeck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
